# =====================================================================
# Andela Agentic Observability Platform — environment variables
# =====================================================================
# Copy this file to `.env` (gitignored) and fill in real values.
# Never commit `.env` or the real values themselves.

# --- Backend / Gemini ---
# Used by backend/app/triage/llm_client.py for the agentic triage pipeline.
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-me
# When true (or when GEMINI_API_KEY is unset), the triage pipeline returns
# deterministic mock responses instead of calling the Gemini API.
USE_MOCK_AI=true
# Gemini model used by all agents (override only for benchmarking).
MODEL_NAME=gemini-1.5-flash

# --- Database (default SQLite local file; override for tests/CI) ---
WATCHDOG_DATABASE_URL=sqlite:///./var/watchdog.db

# --- App config ---
WATCHDOG_LOG_LEVEL=INFO
WATCHDOG_REQUEST_BODY_MAX_BYTES=1048576
WATCHDOG_BATCH_MAX_EVENTS=1000

# --- Detection thresholds (override the defaults if needed) ---
DETECTION_Z_SCORE_THRESHOLD=3.0
DETECTION_EWMA_ALPHA=0.3
DETECTION_EWMA_DRIFT_THRESHOLD=2.5
DETECTION_SIGNATURE_BURST_MULTIPLIER=5.0
DETECTION_SIGNATURE_MIN_ABSOLUTE=10

# --- Triage cost guards ---
TRIAGE_PER_INCIDENT_TOKEN_BUDGET=4000
TRIAGE_DEFAULT_MODEL=gemini-1.5-flash
TRIAGE_DEFAULT_TEMPERATURE=0.0

# --- MCP servers (Cursor) ---
# Personal Access Token for the GitHub MCP. Scopes: repo, workflow (only what you need).
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_replace-me
# Optional API key for Context7 MCP (documentation lookup).
CONTEXT7_API_KEY=ctx7_replace-me

# --- Webhooks (Alert Engine, optional) ---
# Allow-listed outbound destinations for webhook alerts (comma-separated).
ALLOWED_WEBHOOK_HOSTS=hooks.slack.com,example.com
